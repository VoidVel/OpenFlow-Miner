{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingestion": {
    "MaxEvents": 1000000
  },
  "Storage": {
    "UploadTtlHours": 24
  },
  "RateLimiting": {
    "AnonymousPermitLimit": 100,
    "KeyedPermitLimit": 1000,
    "WindowSeconds": 60
  },
  "ApiKeys": {
    "LifetimeDays": 30
  }
}
